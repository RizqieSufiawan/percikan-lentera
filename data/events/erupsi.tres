[resource]
script = ExtResource("3_hetpq")
id = &"erupsi"
title = "Erupsi Gunung Api"
body = "Gunung api di dekat {village}, {province}, meletus. Abu menutupi atap dan panel."
fact = "Indonesia punya 127 gunung api, sekitar 13% gunung api dunia, dan sekitar 45 juta jiwa tinggal di sekitarnya. Panas dari gunung api juga sumber energi panas bumi. (Sumber: Kementerian ESDM, 7 Agustus 2024)"
image = ExtResource("1_4y57v")
is_disaster = true
target_traits = Array[StringName]([&"gunung_api"])
vulnerable_energies = Array[StringName]([&"panas_bumi", &"plts"])
