title = "Warga Membakar Sisa Lahan"
body = "Warga {village}, {province}, membakar sisa panen karena tidak ada cara lain mengolahnya."
fact = "Potensi bioenergi Indonesia 32.654 MW, antara lain dari limbah sawit, sekam, dan sisa panen. Limbah yang diolah menjadi listrik tidak perlu dibakar di lahan. (Sumber: Perpres No. 22 Tahun 2017 tentang RUEN)"
