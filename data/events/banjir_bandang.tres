[resource]
script = ExtResource("3_sb2yk")
id = &"banjir_bandang"
title = "Banjir Bandang"
body = "Hujan deras berhari-hari. Sungai di dekat {village}, {province}, meluap dan membawa lumpur."
fact = "Banjir adalah bencana paling sering di Indonesia: 1.420 dari 3.472 kejadian bencana sepanjang 2024. Pembangkit di tepi sungai perlu dirancang tahan banjir. (Sumber: BNPB, Buku Data Bencana Indonesia 2024)"
image = ExtResource("1_qcfln")
is_disaster = true
