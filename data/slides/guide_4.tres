[ext_resource type="Script" path="res://scripts/data/slide_data.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
title = "Membangun"
text = "Kloter pertama dipilih di layar persiapan dan langsung dibangun. Pembangunan butuh 2–4 bulan dan bisa tertunda bencana.\nSetelah pembangkit terbukti menyala, warga membangun kloter berikutnya sendiri: hanya di kloter dekat (paling jauh 2 kloter), yang cocok dengan energi yang sudah kamu buka, dan jika Komunitas wilayah minimal 20. Wilayah yang kamu klik didahulukan.\nKecocokan baru terungkap saat pembangkit menyala."
image = ExtResource("1_img")
