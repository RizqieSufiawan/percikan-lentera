[resource]
script = ExtResource("2_script")
title = "Membangun"
text = "Kloter pertama dipilih di layar persiapan dan langsung dibangun. Pembangunan butuh 2–4 bulan dan bisa tertunda bencana.\nOtomatis (B): warga membangun kloter berikutnya sendiri, tapi hanya di desa yang cocok dengan energi yang sudah kamu buka, dan jika Komunitas wilayah minimal 20. Mau memilih sendiri? Klik kloter lalu Bangun.\nKecocokan baru terungkap saat pembangkit menyala."
image = ExtResource("1_img")
