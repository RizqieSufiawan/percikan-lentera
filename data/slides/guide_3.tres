[resource]
script = ExtResource("2_script")
title = "Empat Status Desa"
text = "Abu = GELAP: masih ada warga tanpa listrik.\nCoklat = FOSIL: listrik dari PLTU, PLTD, atau genset.\nKuning = RAPUH: energi bersih, belum ada warga yang mampu merawatnya.\nHijau = MANDIRI: dirawat warga sendiri."
image = ExtResource("1_img")
