[resource]
script = ExtResource("2_script")
title = "Waktu Berjalan"
text = "Waktu berjalan sendiri: Jeda, 1x, 2x, 3x (Spasi, 1, 2, 3). Tombol - di pojok panel (atau Tab) melipat panel supaya peta terlihat.\nSelama KKN waktu diperlambat. Setelahnya satu tahun berlalu sekitar 26 detik.\nGame berhenti sendiri saat ada keputusan penting."
image = ExtResource("1_img")
