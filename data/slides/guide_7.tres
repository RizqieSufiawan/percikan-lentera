[resource]
script = ExtResource("2_script")
title = "KKN Selesai"
text = "Poin dari mahasiswa berhenti setelah 6 bulan. Selama KKN mahasiswa melatih warga wilayah awal; desa rapuh di wilayah yang Komunitasnya masih lemah bisa padam saat tim pulang.\nSetelah itu, desa rapuh menjadi mandiri jika Komunitas mencapai 45."
image = ExtResource("1_img")
