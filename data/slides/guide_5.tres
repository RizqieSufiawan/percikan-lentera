[resource]
script = ExtResource("2_script")
title = "Poin, Ekonomi, Pohon Upgrade"
text = "POIN DUKUNGAN: selama KKN dari tim KKN tiap minggu dan hadiah Misi KKN; setelah KKN dari desa Rapuh dan Mandiri, ditambah Komunitas wilayah. Bonus dari gelembung di peta.\nEKONOMI: bertambah sedikit tiap bulan, lebih banyak dari desa Mandiri. Selalu disisakan 5 sebagai cadangan.\nKeduanya dipakai di Pohon Upgrade (U). Setiap pembelian membuat upgrade lain 5% lebih mahal. Sumber Energi: buka dan perkuat energi. Edukasi & Warga: Komunitas lebih cepat, resistensi turun. Layanan Digital: internet di wilayah berenergi bersih."
image = ExtResource("1_img")
