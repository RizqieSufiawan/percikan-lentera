[resource]
script = ExtResource("2_script")
title = "Penyebaran"
text = "Desa meniru energi desa tetangganya, tapi hanya energi yang cocok dengan alamnya. Desa yang tidak cocok menunggu sampai kamu membuka energi yang cocok.\nDarat: ke wilayah tetangga. Internet: menanam benih di pulau jauh, dan wilayah benih bisa langsung dibangun. Pesawat: dibuka lewat kerja sama pemerintah."
image = ExtResource("1_img")
