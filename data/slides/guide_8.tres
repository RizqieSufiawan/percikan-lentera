script = ExtResource("2_script")
title = "Pemerintah, Event, Bencana"
text = "Tawaran pemerintah: Terima atau Tolak. Isinya tergantung kinerjamu.\nKartu event: pilih A atau B, tidak ada pilihan yang selalu benar.\nBencana menyasar desa sesuai ciri alamnya, dan paling merusak energi yang rentan."
image = ExtResource("1_img")
