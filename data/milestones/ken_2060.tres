title = "Target Nasional 2060"
intro = "Kebijakan Energi Nasional menargetkan bauran energi baru dan terbarukan 70–72% pada 2060, tahun target Net Zero Emission Indonesia. Di game ini: 70% desa berenergi bersih dan setengahnya dirawat warga sendiri."
