[resource]
script = ExtResource("p_script")
id = &"sumut"
display_name = "Sumatera Utara"
short_name = "Sumut"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(126, 231)
label_offset = Vector2(3, -29)
neighbors = Array[StringName]([&"aceh", &"riau"])
villages = 13
fossil_villages = 9
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4"), SubResource("k_5"), SubResource("k_6"), SubResource("k_7"), SubResource("k_8"), SubResource("k_9"), SubResource("k_10"), SubResource("k_11"), SubResource("k_12")])
start_resistance_mod = -2.0
compat_override = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 1.0, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 12.1, &"badai_pesisir": 2.9, &"kemarau_panjang": 1.2, &"erupsi": 0.0, &"titik_api": 0.2})
member_provinces = PackedStringArray("Sumatera Utara")
note = "Komunitas kuat: resistensi awal sedikit lebih rendah."
