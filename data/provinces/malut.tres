[resource]
script = ExtResource("p_script")
id = &"malut"
display_name = "Maluku Utara"
short_name = "Malut"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(904, 273)
neighbors = Array[StringName]([&"maluku"])
villages = 3
fossil_villages = 2
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2")])
spread_mod = 0.9
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.15, &"biomassa": 0.15, &"angin": 0.5, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 18.4, &"badai_pesisir": 8.4, &"kemarau_panjang": 0.8, &"erupsi": 0.8, &"titik_api": 0.6})
member_provinces = PackedStringArray("Maluku Utara")
note = "Kepulauan: dari luar Maluku hanya terjangkau lewat internet atau pesawat."
