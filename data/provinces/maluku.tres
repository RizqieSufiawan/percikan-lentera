origin = "Maluku"
compat = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.5, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 1.0})

[sub_resource type="Resource" id="k_2"]
script = ExtResource("v_script")
display_name = "Negeri Hatu Raya"
traits = Array[StringName]([&"pesisir_berangin", &"gunung_api"])
