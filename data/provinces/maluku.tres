[gd_resource type="Resource" script_class="ProvinceData" format=3]

[ext_resource type="Script" path="res://scripts/data/province_data.gd" id="p_script"]
[ext_resource type="Resource" path="res://data/islands/maluku.tres" id="p_island"]
[ext_resource type="Texture2D" path="res://assets/map/regions/maluku.png" id="p_region"]
[ext_resource type="Script" path="res://scripts/data/village_data.gd" id="v_script"]

[sub_resource type="Resource" id="k_0"]
script = ExtResource("v_script")
display_name = "Negeri Hatu Manis"
traits = Array[StringName]([&"pesisir_berangin"])
size = 458
origin = "Maluku"
compat = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.5, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 1.0})

[sub_resource type="Resource" id="k_1"]
script = ExtResource("v_script")
display_name = "Negeri Hatu Putih"
