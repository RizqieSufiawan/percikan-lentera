[resource]
script = ExtResource("p_script")
id = &"maluku"
display_name = "Maluku"
short_name = "Maluku"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(970, 389)
neighbors = Array[StringName]([&"malut"])
villages = 3
fossil_villages = 2
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2")])
spread_mod = 0.9
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.5, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 14.2, &"badai_pesisir": 21.6, &"kemarau_panjang": 2.9, &"erupsi": 0.0, &"titik_api": 3.6})
member_provinces = PackedStringArray("Maluku")
note = "Kepulauan: dari luar Maluku hanya terjangkau lewat internet atau pesawat."
