[gd_resource type="Resource" script_class="ProvinceData" format=3]

[ext_resource type="Script" path="res://scripts/data/province_data.gd" id="p_script"]
[ext_resource type="Resource" path="res://data/islands/sumatra.tres" id="p_island"]
[ext_resource type="Texture2D" path="res://assets/map/regions/babel.png" id="p_region"]
[ext_resource type="Script" path="res://scripts/data/village_data.gd" id="v_script"]

[sub_resource type="Resource" id="k_0"]
script = ExtResource("v_script")
display_name = "Desa Simpang Hijau"
traits = Array[StringName]([&"hutan_berkabut", &"limbah_perkebunan"])
size = 71
origin = "Babel"
compat = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 0.15, &"biomassa": 0.5, &"angin": 1.0, &"panas_bumi": 0.5})

[sub_resource type="Resource" id="k_1"]
script = ExtResource("v_script")
display_name = "Desa Muara Mulia"
traits = Array[StringName]([&"pesisir_berangin", &"lahan_terik"])
