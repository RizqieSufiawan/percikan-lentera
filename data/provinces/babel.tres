label_offset = Vector2(-2, -27)
neighbors = Array[StringName]([&"sumsel"])
villages = 2
fossil_villages = 1
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1")])
spread_mod = 0.9
compat_override = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 0.15, &"biomassa": 0.5, &"angin": 1.0, &"panas_bumi": 0.5})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 13.0, &"badai_pesisir": 20.9, &"kemarau_panjang": 4.6, &"erupsi": 0.0, &"titik_api": 15.3})
member_provinces = PackedStringArray("Kepulauan Bangka Belitung")
note = ""
