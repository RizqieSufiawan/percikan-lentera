[gd_resource type="Resource" script_class="ProvinceData" format=3]

[ext_resource type="Script" path="res://scripts/data/province_data.gd" id="p_script"]
[ext_resource type="Resource" path="res://data/islands/kalimantan.tres" id="p_island"]
[ext_resource type="Texture2D" path="res://assets/map/regions/kaltim.png" id="p_region"]
[ext_resource type="Script" path="res://scripts/data/village_data.gd" id="v_script"]

[sub_resource type="Resource" id="k_0"]
script = ExtResource("v_script")
display_name = "Desa Muara Bahau"
traits = Array[StringName]([&"sungai_deras", &"hutan_berkabut"])
size = 194
origin = "Kaltim"
compat = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 1.0, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 0.15})

[sub_resource type="Resource" id="k_1"]
script = ExtResource("v_script")
display_name = "Desa Muara Apari"
traits = Array[StringName]([&"lahan_terik"])
