size = 429
origin = "Kaltim"
compat = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 1.0, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 0.15})

[sub_resource type="Resource" id="k_2"]
script = ExtResource("v_script")
display_name = "Desa Tumbang Seluang"
traits = Array[StringName]([&"limbah_perkebunan"])
start_fossil = true
size = 429
origin = "Kaltim"
