label_offset = Vector2(0, -30)
neighbors = Array[StringName]([&"kalbar", &"kalteng", &"kalsel"])
villages = 5
fossil_villages = 3
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4")])
start_resistance_mod = 3.0
compat_override = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 1.0, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 0.15})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 28.7, &"badai_pesisir": 2.3, &"kemarau_panjang": 3.8, &"erupsi": 0.0, &"titik_api": 4.8})
member_provinces = PackedStringArray("Kalimantan Timur", "Kalimantan Utara")
note = "Daerah tambang: tekanan energi lama lebih kuat."
