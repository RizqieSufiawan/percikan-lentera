[resource]
script = ExtResource("p_script")
id = &"kaltim"
display_name = "Kalimantan Timur"
short_name = "Kaltim"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(595, 292)
label_offset = Vector2(-2, -38)
neighbors = Array[StringName]([&"kalbar", &"kalteng", &"kalsel", &"kaltara"])
villages = 3
fossil_villages = 2
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2")])
start_resistance_mod = 3.0
compat_override = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 1.0, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 0.15})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 27.1, &"badai_pesisir": 2.9, &"kemarau_panjang": 4.6, &"erupsi": 0.0, &"titik_api": 5.6})
member_provinces = PackedStringArray("Kalimantan Timur")
note = "Daerah tambang: tekanan energi lama lebih kuat."
