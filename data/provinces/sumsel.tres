[resource]
script = ExtResource("p_script")
id = &"sumsel"
display_name = "Sumatera Selatan, Jambi & Bangka Belitung"
short_name = "Sumsel-Jambi"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(242, 358)
label_offset = Vector2(0, -30)
neighbors = Array[StringName]([&"riau", &"lampung"])
villages = 12
fossil_villages = 9
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4"), SubResource("k_5"), SubResource("k_6"), SubResource("k_7"), SubResource("k_8"), SubResource("k_9"), SubResource("k_10"), SubResource("k_11")])
spread_mod = 0.9
compat_override = Dictionary[StringName, float]({&"plts": 1.0, &"mikrohidro": 0.5, &"biomassa": 1.0, &"angin": 0.15, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 27.8, &"badai_pesisir": 2.6, &"kemarau_panjang": 3.7, &"erupsi": 0.0, &"titik_api": 4.7})
member_provinces = PackedStringArray("Sumatera Selatan", "Jambi", "Kepulauan Bangka Belitung")
note = ""
