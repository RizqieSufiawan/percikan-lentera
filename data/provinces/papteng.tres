[gd_resource type="Resource" script_class="ProvinceData" format=3]

[ext_resource type="Script" path="res://scripts/data/province_data.gd" id="p_script"]
[ext_resource type="Resource" path="res://data/islands/papua.tres" id="p_island"]
[ext_resource type="Texture2D" path="res://assets/map/regions/papteng.png" id="p_region"]
[ext_resource type="Script" path="res://scripts/data/village_data.gd" id="v_script"]

[sub_resource type="Resource" id="k_0"]
script = ExtResource("v_script")
display_name = "Kampung Kiwani"
traits = Array[StringName]([&"sungai_deras", &"lembah_tertutup"])
size = 422
origin = "Papua Tengah"
compat = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})

[sub_resource type="Resource" id="k_1"]
script = ExtResource("v_script")
display_name = "Kampung Monage"
traits = Array[StringName]([&"sungai_deras"])
size = 421
origin = "Papua Tengah"
compat = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})

[sub_resource type="Resource" id="k_2"]
script = ExtResource("v_script")
display_name = "Kampung Medoki"
traits = Array[StringName]([&"hutan_berkabut"])
start_fossil = true
size = 365
origin = "Papua Tengah"
compat = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})

[resource]
script = ExtResource("p_script")
id = &"papteng"
display_name = "Papua Tengah"
short_name = "Papua Tengah"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(1150, 413)
label_offset = Vector2(-36, -29)
neighbors = Array[StringName]([&"pabar", &"papua", &"papeg", &"papsel"])
villages = 3
fossil_villages = 1
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2")])
start_resistance_mod = 2.0
spread_mod = 0.8
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 6.9, &"badai_pesisir": 0.4, &"kemarau_panjang": 0.6, &"erupsi": 0.0, &"titik_api": 0.2})
member_provinces = PackedStringArray("Papua Tengah")
note = "Pegunungan terpencil. Libatkan tokoh adat."
