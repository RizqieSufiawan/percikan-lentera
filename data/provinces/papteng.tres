[resource]
script = ExtResource("p_script")
id = &"papteng"
display_name = "Papua Tengah, Pegunungan & Selatan"
short_name = "Papua Tengah"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(1220, 442)
neighbors = Array[StringName]([&"pabar", &"papua"])
villages = 10
fossil_villages = 3
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4"), SubResource("k_5"), SubResource("k_6"), SubResource("k_7"), SubResource("k_8"), SubResource("k_9")])
start_resistance_mod = 2.0
spread_mod = 0.8
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 5.6, &"badai_pesisir": 0.6, &"kemarau_panjang": 0.2, &"erupsi": 0.0, &"titik_api": 0.2})
member_provinces = PackedStringArray("Papua Tengah", "Papua Pegunungan", "Papua Selatan")
note = "Pegunungan terpencil dan pesisir selatan. Libatkan tokoh adat."
