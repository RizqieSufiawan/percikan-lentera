[resource]
script = ExtResource("p_script")
id = &"jabar"
display_name = "Jawa Barat, DKI Jakarta & Banten"
short_name = "Jabar"
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(343, 483)
neighbors = Array[StringName]([&"jateng"])
villages = 18
fossil_villages = 16
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4"), SubResource("k_5"), SubResource("k_6"), SubResource("k_7"), SubResource("k_8"), SubResource("k_9"), SubResource("k_10"), SubResource("k_11"), SubResource("k_12"), SubResource("k_13"), SubResource("k_14"), SubResource("k_15"), SubResource("k_16"), SubResource("k_17")])
start_resistance_mod = 2.0
spread_mod = 1.1
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.15, &"biomassa": 0.5, &"angin": 1.0, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 15.8, &"badai_pesisir": 9.0, &"kemarau_panjang": 9.6, &"erupsi": 0.0, &"titik_api": 1.7})
member_provinces = PackedStringArray("Jawa Barat", "DKI Jakarta", "Banten")
note = "Padat, menyebar cepat, tapi tekanan energi lama lebih besar."
