label_offset = Vector2(6, -16)
neighbors = Array[StringName]([&"banten", &"dki", &"jateng"])
villages = 13
fossil_villages = 12
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4"), SubResource("k_5"), SubResource("k_6"), SubResource("k_7"), SubResource("k_8"), SubResource("k_9"), SubResource("k_10"), SubResource("k_11"), SubResource("k_12")])
start_resistance_mod = 2.0
spread_mod = 1.1
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 0.15, &"biomassa": 0.5, &"angin": 1.0, &"panas_bumi": 1.0})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 13.9, &"badai_pesisir": 9.3, &"kemarau_panjang": 10.2, &"erupsi": 0.0, &"titik_api": 2.0})
member_provinces = PackedStringArray("Jawa Barat")
note = "Padat, menyebar cepat, tapi tekanan energi lama lebih besar."
