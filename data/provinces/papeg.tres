[resource]
script = ExtResource("p_script")
id = &"papeg"
display_name = "Papua Pegunungan"
short_name = "Papua Peg."
island = ExtResource("p_island")
region_mask = ExtResource("p_region")
map_position = Vector2(1225, 417)
label_offset = Vector2(-10, -34)
neighbors = Array[StringName]([&"papteng", &"papua", &"papsel"])
villages = 5
fossil_villages = 1
village_list = Array[ExtResource("v_script")]([SubResource("k_0"), SubResource("k_1"), SubResource("k_2"), SubResource("k_3"), SubResource("k_4")])
start_resistance_mod = 2.0
spread_mod = 0.8
compat_override = Dictionary[StringName, float]({&"plts": 0.5, &"mikrohidro": 1.0, &"biomassa": 0.15, &"angin": 1.0, &"panas_bumi": 0.15})
disaster_rates = Dictionary[StringName, float]({&"banjir_bandang": 3.6, &"badai_pesisir": 0.0, &"kemarau_panjang": 0.0, &"erupsi": 0.0, &"titik_api": 0.1})
member_provinces = PackedStringArray("Papua Pegunungan")
note = "Pegunungan terpencil. Libatkan tokoh adat."
